        "bought_relics": {"type": "array", "items": {"$ref": "#/$defs/ModelId"}},
        "card_choices": {"type": "array", "items": {"$ref": "#/$defs/CardChoiceHistoryEntry"}},
        "cards_enchanted": {"type": "array", "items": {"$ref": "#/$defs/CardEnchantmentHistoryEntry"}},
        "cards_gained": {"type": "array", "items": {"$ref": "#/$defs/SerializableCard"}},
        "cards_removed": {"type": "array", "items": {"$ref": "#/$defs/SerializableCard"}},
        "cards_transformed": {"type": "array", "items": {"$ref": "#/$defs/CardTransformationHistoryEntry"}},
        "completed_quests": {"type": "array", "items": {"$ref": "#/$defs/ModelId"}},
        "current_gold": {"$ref": "#/$defs/Int32"},
        "current_hp": {"$ref": "#/$defs/Int32"},
        "damage_taken": {"$ref": "#/$defs/Int32"},
        "downgraded_cards": {"type": "array", "items": {"$ref": "#/$defs/ModelId"}},
