{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sts2-simulator.local/schema/native/serializable-run-v20.json",
  "title": "Native Slay the Spire 2 SerializableRun v20",
  "description": "Structural schema for native v0.111.0 JSON saves, derived from the installed game serializer contracts and custom converters. Describes saved output, including optional/default-valued fields; does not establish gameplay validity or cross-version compatibility.",
  "$comment": "Reference DLL SHA-256: 0861bfa1df347538d932f22d580e75420f08082792eb914e53b4882764acdbe9. No compact encoding, envelope, or simulator-only fields. Required fields reflect unconditional native serialization; the native deserializer may accept additional omissions or unknown fields.",
  "$ref": "#/$defs/SerializableRun",
  "$defs": {
    "Int32": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "Int64": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
    "UInt64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "description": "Native JSON integer, not a string. Requires integer-safe parsing."
    },
    "ModelId": {
      "type": "string",
      "pattern": "^[^.]+\\.[^.]+$",
      "description": "Native CATEGORY.ENTRY string. Model existence/category compatibility is checked by the game."
    },
    "MapDrawings": {
      "type": ["string", "null"],
      "contentEncoding": "base64",
      "description": "Native SerializableMapDrawings packet bytes compressed with gzip, then encoded as Base64. JSON Schema does not validate the compressed packet payload.",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "SerializableRun": {
      "type": "object",
      "properties": {
        "acts": {"type": "array", "items": {"$ref": "#/$defs/SerializableActModel"}},
        "ascension": {"$ref": "#/$defs/Int32"},
        "current_act_index": {"$ref": "#/$defs/Int32"},
        "dailyTime": {"type": ["string", "null"], "format": "date-time"},
        "events_seen": {"type": "array", "items": {"$ref": "#/$defs/ModelId"}},
        "extra_fields": {"$ref": "#/$defs/SerializableExtraRunFields"},
        "game_mode": {"$ref": "#/$defs/GameMode"},
        "map_drawings": {"$ref": "#/$defs/MapDrawings"},
        "map_point_history": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/MapPointHistoryEntry"}}},
        "modifiers": {"type": "array", "items": {"$ref": "#/$defs/SerializableModifier"}},
        "num_reloads": {"$ref": "#/$defs/Int32"},
        "odds": {"$ref": "#/$defs/SerializableRunOddsSet"},
        "platform_type": {"$ref": "#/$defs/PlatformType"},
        "players": {"type": "array", "items": {"$ref": "#/$defs/SerializablePlayer"}},
        "pre_finished_room": {"anyOf": [{"$ref": "#/$defs/SerializableRoom"}, {"type": "null"}]},
        "rng": {"$ref": "#/$defs/SerializableRunRngSet"},
        "run_time": {"$ref": "#/$defs/Int64"},
        "save_time": {"$ref": "#/$defs/Int64"},
        "schema_version": {"type": "integer", "const": 20},
        "shared_relic_grab_bag": {"$ref": "#/$defs/SerializableRelicGrabBag"},
        "start_time": {"$ref": "#/$defs/Int64"},
        "visited_map_coords": {"type": "array", "items": {"$ref": "#/$defs/MapCoord"}},
        "win_time": {"$ref": "#/$defs/Int64"}
      },
      "additionalProperties": false,
      "$comment": "Native type: MegaCrit.Sts2.Core.Saves.SerializableRun",
      "required": [
        "ascension",
        "current_act_index",
        "extra_fields",
        "game_mode",
        "map_drawings",
        "modifiers",
        "num_reloads",
        "odds",
        "platform_type",
        "players",
        "pre_finished_room",
        "rng",
        "run_time",
        "save_time",
        "schema_version",
        "shared_relic_grab_bag",
        "start_time",
        "win_time"
      ]
    },
    "SerializableActModel": {
      "type": "object",
      "properties": {
        "id": {"anyOf": [{"$ref": "#/$defs/ModelId"}, {"type": "null"}]},
        "rooms": {"$ref": "#/$defs/SerializableRoomSet"},
        "saved_map": {"anyOf": [{"$ref": "#/$defs/SerializableActMap"}, {"type": "null"}]}
      },
      "additionalProperties": false,
      "$comment": "Native type: MegaCrit.Sts2.Core.Saves.Runs.SerializableActModel",
      "required": ["id", "rooms"]
    },
    "SerializableRoomSet": {
      "type": "object",
      "properties": {
        "ancient_id": {"anyOf": [{"$ref": "#/$defs/ModelId"}, {"type": "null"}]},
