        "elite_encounter_ids": {"type": "array", "items": {"$ref": "#/$defs/ModelId"}},
        "elite_encounters_visited": {"$ref": "#/$defs/Int32"},
        "event_ids": {"type": "array", "items": {"$ref": "#/$defs/ModelId"}},
        "events_visited": {"$ref": "#/$defs/Int32"},
        "normal_encounter_ids": {"type": "array", "items": {"$ref": "#/$defs/ModelId"}},
        "normal_encounters_visited": {"$ref": "#/$defs/Int32"},
        "second_boss_id": {"anyOf": [{"$ref": "#/$defs/ModelId"}, {"type": "null"}]}
      },
      "additionalProperties": false,
      "$comment": "Native type: MegaCrit.Sts2.Core.Saves.Runs.SerializableRoomSet",
      "required": [
        "ancient_id",
        "boss_encounters_visited",
        "boss_id",
        "elite_encounters_visited",
        "events_visited",
        "normal_encounters_visited",
        "second_boss_id"
      ]
    },
    "SerializableActMap": {
