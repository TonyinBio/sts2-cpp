        "relic_choices": {"type": "array", "items": {"$ref": "#/$defs/ModelChoiceHistoryEntry"}},
        "relics_removed": {"type": "array", "items": {"$ref": "#/$defs/ModelId"}},
        "rest_site_choices": {"type": "array", "items": {"type": "string"}},
        "stolen_loot": {"$ref": "#/$defs/Int32"},
        "upgraded_cards": {"type": "array", "items": {"$ref": "#/$defs/ModelId"}}
      },
