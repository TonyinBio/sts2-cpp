  "records": [
    {
      "kind": "deck-and-combat-card",
      "native_facts": [
        "Player clones each permanent deck card into combat then sets clone.DeckVersion to permanent instance.",
        "Native creation clone resets DeckVersion/current target/index/removal flag; simulator state clone must instead preserve pending state."
      ],
      "references": [
        "owner",
        "DeckVersion",
        "CloneOf",
        "enchantment.Card",
        "affliction.Card",
        "pile memberships",
        "history/active play"
      ],
      "retire_preconditions": [
        "no live semantic reference or required identity/export consumer",
        "no authoritative membership",
        "enclosing operation/dispatch finished or its required data independently preserved"
      ]
    },
    {
      "kind": "floating-and-removed-card",
      "native_facts": [
        "RunState/CombatState register created/cloned cards independently of piles.",
        "CardModel.RemoveFromState removes current pile and sets removed flag; retains owner and registry/list references.",
        "Scope RemoveCard is a different API which removes registry entry and clears owner."
      ],
      "references": [
        "CardCreationResult.originalCard",
        "CardCreationResult.modifiedCard",
        "modifying relics",
        "captured original/replacement/pile/index"
      ],
      "retire_preconditions": [
        "cannot infer reclamation from removed flag, skip or empty pile",
        "native scope list remains strong unless explicitly removed; simulator earlier reclamation requires semantic proof"
      ]
    },
    {
      "kind": "consumed-potion",
      "native_facts": [
        "Slot becomes null without compacting others; source owner retained.",
        "Removal precedes BeforePotionUsed/OnUse, source is still read after asynchronous choice and by later callbacks."
      ],
      "references": [
        "choice context source stack",
        "pending operation source",
        "captured target",
        "owner",
        "post-use history"
      ],
      "retire_preconditions": [
        "effect and all downstream callbacks/continuations/history consumers have completed"
      ]
    },
    {
      "kind": "removed-or-melted-relic",
      "native_facts": [
        "Removal drops ordered inventory membership and marks removed but retains owner.",
        "Melt keeps inventory instance with melted/disabled flags.",
        "AfterRemoved runs on removed source; replacement preserves inventory position with distinct instance."
      ],
      "references": [
        "captured dispatch",
        "operation source",
        "CardCreationResult.modifyingRelics",
        "owner"
      ],
      "retire_preconditions": [
        "direct callback/operation users done",
        "no remaining semantic reference; hook ineligibility is distinct from object lifetime"
      ]
    },
    {
      "kind": "persistent-versus-combat-local-inventory-state",
      "native_facts": [
        "Nunchaku.AttacksPlayed, Pendulum.TurnsSeen, JossPaper.CardsExhausted, SilkenTress.IsUsed and SeaGlass character identity persist according to native saved fields and hook consumers.",
        "Other observed flags/counters reset at specific turn/combat/room hooks; no blanket room reset is valid."
      ],
      "references": [
        "model runtime/saved properties",
        "dynamic values",
        "hook stage"
      ],
      "retire_preconditions": [
        "model removed and no semantic users",
        "relevant reset hook performed rather than inferred from allocation scope"
      ]
    },
    {
      "kind": "export-surface",
      "native_facts": [
        "Adapter traverses inventory/history/active/pending/model references, exporting consumed inventory sources separately.",
        "Adapter includes DeckVersion/CloneOf/removed/cost/attachment state but does not prove scope-allCards or native async-local completeness."
      ],
      "references": [
        "registered native instance paths",
        "retained_inventory_models",
        "pending sources",
        "model fields"
      ],
      "retire_preconditions": [
        "preserve required comparison relationships independently of native allocation shape"
      ]
    }
  ],
  "required_invariants": [
    "Separate stable identity from membership and logical removed/subscribed status.",
    "Complete-state clone preserves aliasing internally and isolation externally.",
    "Do not rerun native creation/reset hooks on checkpoint restore.",
    "Retire only with no live semantic consumer; preserve generation and free-slot identity behavior.",
    "No one-run maximum establishes capacity."
  ],
  "regressions": [
    "permanent card removal/transformation while combat clone lives",
    "floating original and modified reward offers across choose/skip/cancel",
    "consumed choice potion across sparse-slot clone/checkpoint/resume",
    "relic removal/replacement during dispatch with retained source",
    "saved versus turn/combat counter resets over two combats"
  ],
  "limits": [
    "Static source evidence only.",
    "Native object creation clone is not simulator complete-state clone.",
    "No whole-content reference closure or GC-timing equivalence claim.",
    "Parent audit covers histories, entities and enclosing room/combat retirement."
