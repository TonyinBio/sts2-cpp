classDiagram
    direction TB

    class RunState {
        +RunData data
        +OverflowStorage overflow
        +OverflowStorage combat_overflow
        +view() RunView
        +reset()
    }
    class RunData {
        +character
        +ascension
        +hp
        +max_hp
        +gold
        +deck
        +relics
        +potions
        +relic_bags
        +act_queues
        +reward_odds
        +maps
        +visited
        +RunPhase phase
        +BoundaryId boundary
        +RunClock clock
    }
    class CombatState {
        +CombatData data
        +OverflowStorage overflow
        +view() CombatView
    }
    class CombatData {
        +CombatPhase phase
        +BoundaryId boundary
        +RunClock clock
        +energy
        +turn
        +enemy_move
        +zones
        +execution
        +CombatCounters counters
        +live_powers
        +next_power_instance
    }
    class CreatureState {
        +hp
        +max_hp
        +block
        +vulnerable
        +shrink
        +positive_unblocked_hits
    }
    class PersistentCard {
        +ContentId definition
        +instance
        +upgrade
        +floor_added
    }
    class CardInstance {
        +CardId definition
        +upgraded
        +creation_order
        +deck_instance
        +last_finished_player_turn
    }
    class CardHandle {
        +slot
        +generation
    }
    class PoolData {
        +slots
        +free
        +generation_metadata
    }
    class EffectFrame {
        +CardHandle source
        +instruction
        +play_identity
        +energy
        +enemy_target
    }
    class CombatCounters
    class CombatEvent
    class RecordedCardPlay
    class PowerInstance
    class NativeRunExporter {
        +diagnostic_history
        +completed_plays
        +retained_powers
    }
    class CombatRewards
    class MapState
    class RelicBagData
    class ActRoomsData
    class RngBank
    class PlayerRngBank

    class InlineSequence {
        +inline_values
        +count
        +overflow_id
    }
    class OverflowStorage {
        +clone_from()
        +create()
        +grow()
        +reset()
    }
    class StorageAllocator {
        +context
        +allocate
        +deallocate
    }
    class RunView {
        <<borrowed internal view>>
    }
    class CombatView {
        <<borrowed internal view>>
    }

    RunState *-- RunData
    RunState *-- "2" OverflowStorage
    RunData *-- "0..1" CombatData : active combat
    RunData *-- PersistentCard : permanent deck
    RunData *-- RelicBagData
    RunData *-- ActRoomsData
    RunData *-- RngBank
    RunData *-- PlayerRngBank
    RunData *-- "0..3" MapState
    RunData *-- "0..1" CombatRewards

    CombatState *-- CombatData : standalone combat
    CombatState *-- OverflowStorage
    CombatData *-- "2" CreatureState
    CombatData *-- RngBank
    CombatData *-- PoolData : card pool
    PoolData *-- CardInstance
    CombatData *-- CardHandle : piles
    CardHandle --> CardInstance : slot and generation
    CardInstance --> PersistentCard : deck_instance ID

    CombatData *-- EffectFrame
    CombatData *-- CombatCounters
    CombatData *-- PowerInstance : live only
    NativeRunExporter *-- CombatEvent : diagnostic log
    NativeRunExporter *-- RecordedCardPlay
    NativeRunExporter *-- PowerInstance : includes expired diagnostics
    CombatData ..> NativeRunExporter : optional synchronous trace

    RunData *-- InlineSequence
    CombatData *-- InlineSequence
    InlineSequence ..> OverflowStorage : overflow_id
    OverflowStorage --> StorageAllocator

    RunState ..> RunView : creates
    RunView --> RunData : borrows
    RunView --> OverflowStorage : borrows
    CombatState ..> CombatView : creates
    CombatView --> CombatData : borrows
    CombatView --> OverflowStorage : borrows
